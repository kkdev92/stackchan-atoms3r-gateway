bin/
obj/
.packages/
TestResults/

# Keep the local feed directory referenced by nuget.config, but do not track
# packages generated by pack-sdk.ps1.
local-nuget/*
!local-nuget/.gitkeep

# Local MCP server configuration for AI-assisted development. Machine-specific.
.mcp.json

# Local authentication tokens and API keys.
.secrets/
.env
*.env
!.env.example

# Audio generated by device-sim or diagnostics may contain conversation content.
*.wav
*.mp3
*.pcm

# Workspace for plans and investigation notes that are not published artifacts.
work/
