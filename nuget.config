<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Declare package sources explicitly so parent directories and machine settings cannot alter them. -->
  <packageSources>
    <clear />
    <add key="local-sdk" value="local-nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Source used by NuGet vulnerability auditing. -->
  <auditSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </auditSources>

  <!-- Restore only StackChan Gateway SDK packages from the local feed. -->
  <packageSourceMapping>
    <packageSource key="local-sdk">
      <package pattern="Kkdev92.StackChan.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <config>
    <add key="globalPackagesFolder" value=".packages" />
  </config>
</configuration>
