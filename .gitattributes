# Line endings are LF everywhere, matching .editorconfig. Without this, a
# checkout on Windows with core.autocrlf=true produces CRLF and then contradicts
# the end_of_line = lf that every editor in the project is being told to follow.
# It also keeps `dotnet format --verify-no-changes` from disagreeing between the
# Windows and Linux CI runners.
* text=auto eol=lf

# Windows-only entry points. PowerShell handles LF, but a .cmd read by cmd.exe
# needs CRLF.
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Binary, so git neither converts nor tries to merge them.
*.nupkg   binary
*.snupkg  binary
*.wav     binary
*.pcm     binary
*.png     binary
*.zip     binary
