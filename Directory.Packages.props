<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- External dependencies -->
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.17.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.17.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageVersion Include="OpenAI" Version="2.13.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="RichardSzalay.MockHttp" Version="7.1.0" />

    <!-- Dependency injection and options -->
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />

    <!-- StackChan Gateway SDK packages consumed by the application from the local feed -->
    <PackageVersion Include="Kkdev92.StackChan.Gateway.Abstractions" Version="0.1.0" />
    <PackageVersion Include="Kkdev92.StackChan.Gateway.Runtime" Version="0.1.0" />
    <PackageVersion Include="Kkdev92.StackChan.Gateway.Protocol.Atoms3R" Version="0.1.0" />
    <PackageVersion Include="Kkdev92.StackChan.Gateway.Providers" Version="0.1.0" />
    <PackageVersion Include="Kkdev92.StackChan.Gateway.Capabilities" Version="0.1.0" />
    <PackageVersion Include="Kkdev92.StackChan.Gateway.AgentFramework" Version="0.1.0" />
    <PackageVersion Include="Kkdev92.StackChan.Gateway.Diagnostics" Version="0.1.0" />
    <PackageVersion Include="Kkdev92.StackChan.Gateway.TestKit" Version="0.1.0" />
  </ItemGroup>
</Project>
