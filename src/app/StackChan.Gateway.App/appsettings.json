{
  "Urls": "http://0.0.0.0:8787",
  "StackChan": {
    "Runtime": {
      "MaxConcurrentTurns": 2,
      "TurnTimeoutSeconds": 120,
      "MaxSessions": 128,
      "SessionIdleTimeoutMinutes": 120
    },
    "Atoms3R": {
      "Token": "",
      "MaxRequestBodyBytes": 2097152,
      "KeepAliveIntervalSeconds": 3
    },
    "Offline": {
      "Enabled": false,
      "Transcript": "(fixed-response mode)",
      "FixedResponse": []
    },
    "Weather": {
      "Endpoint": "https://api.weatherapi.com/v1",
      "ApiKey": "",
      "DefaultLocation": "Tokyo",
      "Language": "ja",
      "TimeoutSeconds": 10
    },
    "WhisperCpp": {
      "Endpoint": "http://127.0.0.1:8081",
      "Path": "/inference",
      "Language": "ja",
      "MinLanguageProbability": 0.5,
      "TimeoutSeconds": 30
    },
    "PiperPlus": {
      "Endpoint": "http://127.0.0.1:5000",
      "Path": "/tts_live.wav",
      "LengthScale": 1.0,
      "Character": "",
      "TimeoutSeconds": 30
    },
    "Agent": {
      "Endpoint": "http://127.0.0.1:5273/v1",
      "Model": "Phi-4-mini-instruct-generic-cpu:5",
      "ApiKey": "local",
      "Name": "StackChan",
      "MaxOutputTokens": 512,
      "MaxHistoryMessages": 10,
      "Instructions": "",
      "MaxSessions": 128,
      "SessionIdleTimeoutMinutes": 120
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
